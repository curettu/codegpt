{
  "name": "codegpt-vscode-bridge",
  "displayName": "CodeGPT VS Code Bridge",
  "description": "Local bridge between CodeGPT and the VS Code Language Model API.",
  "version": "0.1.0",
  "publisher": "codegpt",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegptBridge.restart",
        "title": "CodeGPT: Restart Local Bridge"
      }
    ],
    "configuration": {
      "title": "CodeGPT Bridge",
      "properties": {
        "codegptBridge.port": {
          "type": "number",
          "default": 3210,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port used by the CodeGPT browser bridge."
        }
      }
    }
  }
}